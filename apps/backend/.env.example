# GLASSWALL gateway configuration. Copy to .env (never committed) or export in the shell.
# Provider order: first available wins; the scripted planner is always last.
GLASSWALL_PROVIDER_ORDER=openai,anthropic,scripted

# Open-weights model on any OpenAI-compatible endpoint (preferred by the PS).
#
# Up to four endpoint slots are tried in order: the bare names, then _2, _3, _4. Each
# slot is a separate vendor with its own key; GLASSWALL_LLM_MODEL takes a
# comma-separated list, and every model is its own link in the chain. Spread the
# fallback across vendors: one exhausted free-tier quota then falls through to another
# reasoner instead of to the scripted planner, which cannot handle an unrehearsed task.
#
# A step prompt is roughly 1.3k tokens, and a task runs 2-12 steps. Endpoints that
# answer the shape this gateway sends (system + user, temperature 0, max_tokens 800,
# response_format json_object):
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#                gemini-3.6-flash, gemini-3.1-flash-lite  (2.5-* is retired for new
#                keys; gemini-flash-latest 503s under load — do not put it first)
#   OpenRouter:  https://openrouter.ai/api/v1
#                Free models need no credits but are 20 req/min and 50 req/day, and
#                are weaker on long multi-step tasks — use them as fallback, not first:
#                  dots-studio/dots-3-note-preview:free          (most reliable free)
#                  nvidia/nemotron-3-super-120b-a12b:free        (correct but slower)
#                google/gemma-4-*:free were persistently rate-limited;
#                nvidia/nemotron-3.5-lightning:free echoed the example instead of planning.
#                Paid meta-llama/llama-3.3-70b-instruct is ~2.5s and needs credits.
#   Groq:        https://api.groq.com/openai/v1           openai/gpt-oss-120b
#                (free tier is ~8k tokens/minute per model plus a daily cap: a couple
#                 of full bench runs exhaust it, so keep it behind a roomier vendor)
#   Ollama:      http://localhost:11434/v1                qwen2.5:7b   (no quota, offline)
#
# Note: OpenRouter serves /models without auth, so a bad key still reports healthy and
# only fails on the first real step — watch the "provider declined" log line.
#GLASSWALL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#GLASSWALL_LLM_MODEL=gemini-3.6-flash,gemini-3.1-flash-lite
#GLASSWALL_LLM_API_KEY=
#GLASSWALL_LLM_VISION=0
#GLASSWALL_LLM_BASE_URL_2=https://openrouter.ai/api/v1
#GLASSWALL_LLM_MODEL_2=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-super-120b-a12b:free
#GLASSWALL_LLM_API_KEY_2=
#GLASSWALL_LLM_BASE_URL_3=https://api.groq.com/openai/v1
#GLASSWALL_LLM_MODEL_3=openai/gpt-oss-120b,openai/gpt-oss-20b

# Fallback: Anthropic Claude (tool-use, vision capable).
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

# Budgets
#GLASSWALL_STEP_BUDGET=20
#GLASSWALL_TIME_BUDGET_MS=300000
#PORT=3000
