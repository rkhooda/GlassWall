# GLASSWALL gateway configuration. Copy to .env (never committed) or export in the shell.
# Provider order: first available wins; the scripted planner is always last.
GLASSWALL_PROVIDER_ORDER=openai,anthropic,scripted

# Open-weights model on any OpenAI-compatible endpoint (preferred by the PS).
#
# Up to four endpoint slots are tried in order: the bare names, then _2, _3, _4. Each
# slot is a separate vendor with its own key; GLASSWALL_LLM_MODEL takes a
# comma-separated list, and every model is its own link in the chain. Spread the
# fallback across vendors: one exhausted free-tier quota then falls through to another
# reasoner instead of to the scripted planner, which cannot handle an unrehearsed task.
#
# A step prompt is roughly 1.3k tokens, and a task runs 2-12 steps.
#   Ollama (local, no quota):  http://localhost:11434/v1        qwen2.5:7b
#   Groq:                      https://api.groq.com/openai/v1   openai/gpt-oss-120b
#   NVIDIA NIM:                https://integrate.api.nvidia.com/v1  meta/llama-3.3-70b-instruct
#   Cerebras:                  https://api.cerebras.ai/v1       llama-3.3-70b
#   Gemini:                    https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.0-flash
#GLASSWALL_LLM_BASE_URL=https://api.groq.com/openai/v1
#GLASSWALL_LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
#GLASSWALL_LLM_API_KEY=
#GLASSWALL_LLM_VISION=0
#GLASSWALL_LLM_BASE_URL_2=https://integrate.api.nvidia.com/v1
#GLASSWALL_LLM_MODEL_2=meta/llama-3.3-70b-instruct
#GLASSWALL_LLM_API_KEY_2=
#GLASSWALL_LLM_BASE_URL_3=http://localhost:11434/v1
#GLASSWALL_LLM_MODEL_3=qwen2.5:7b

# Fallback: Anthropic Claude (tool-use, vision capable).
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

# Budgets
#GLASSWALL_STEP_BUDGET=20
#GLASSWALL_TIME_BUDGET_MS=300000
#PORT=3000
