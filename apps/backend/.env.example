# GLASSWALL gateway configuration. Copy to .env (never committed) or export in the shell.
# Provider order: first available wins; the scripted planner is always last.
GLASSWALL_PROVIDER_ORDER=openai,anthropic,scripted

# Open-weights model on any OpenAI-compatible endpoint (preferred by the PS).
# Ollama locally:   GLASSWALL_LLM_BASE_URL=http://localhost:11434/v1  GLASSWALL_LLM_MODEL=qwen2.5:7b
# Groq (cloud):     GLASSWALL_LLM_BASE_URL=https://api.groq.com/openai/v1 GLASSWALL_LLM_MODEL=llama-3.3-70b-versatile GLASSWALL_LLM_API_KEY=...
#GLASSWALL_LLM_BASE_URL=http://localhost:11434/v1
#GLASSWALL_LLM_MODEL=qwen2.5:7b
#GLASSWALL_LLM_API_KEY=
#GLASSWALL_LLM_VISION=0

# Fallback: Anthropic Claude (tool-use, vision capable).
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

# Budgets
#GLASSWALL_STEP_BUDGET=20
#GLASSWALL_TIME_BUDGET_MS=300000
#PORT=3000
