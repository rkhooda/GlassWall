{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@glasswall/schema": [
        "../../packages/schema/src/index.ts"
      ],
      "@glasswall/schema/*": [
        "../../packages/schema/src/*"
      ],
      "@glasswall/perception": [
        "../../packages/perception/src/index.ts"
      ],
      "@glasswall/perception/*": [
        "../../packages/perception/src/*"
      ],
      "@glasswall/privacy": [
        "../../packages/privacy/src/index.ts"
      ],
      "@glasswall/privacy/*": [
        "../../packages/privacy/src/*"
      ],
      "@glasswall/inference": [
        "../../packages/inference/src/index.ts"
      ],
      "@glasswall/inference/*": [
        "../../packages/inference/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "manifest.json"
  ]
}
