{
  "manifest_version": 3,
  "name": "GLASSWALL Extension",
  "version": "0.1.0",
  "description": "Privacy-preserving browser agent for computer-use tasks",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "*://localhost:5173/*",
    "*://127.0.0.1:5173/*"
  ],
  "content_security_policy": {
    "extension_pages": "connect-src 'self'"
  },
  "action": {
    "default_title": "GLASSWALL"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}