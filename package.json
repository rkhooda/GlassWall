{
  "name": "glasswall",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first browser agents with on-device perception",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@glasswall/bench-site --filter=@glasswall/backend",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen:schema": "turbo run gen:schema",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "verify:boundary": "bash scripts/verify-boundary.sh",
    "bench:leakage": "pnpm --filter @glasswall/eval bench:leakage",
    "build:eval": "pnpm --filter @glasswall/extension build:eval && pnpm --filter @glasswall/extension build:unsafe",
    "bench:smoke": "pnpm --filter @glasswall/eval bench:smoke",
    "bench:all": "pnpm --filter @glasswall/eval bench:all",
    "bench:report": "pnpm --filter @glasswall/eval bench:report",
    "bench:frontier": "pnpm --filter @glasswall/eval bench:frontier",
    "bench:chaos": "pnpm --filter @glasswall/eval bench:chaos"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.6.0",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
