{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "harness/**/*",
    "tasks/**/*",
    "leakage/**/*",
    "ablations/**/*",
    "metrics/**/*"
  ],
  "exclude": ["node_modules", "dist", "reports"]
}
